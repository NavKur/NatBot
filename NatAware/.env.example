# Copy to .env and fill in. Never commit .env.

# --- Required for the real voice-to-chat loop ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=          # Whisper speech-to-text (not needed with --text)
ELEVENLABS_API_KEY=      # text-to-speech (not needed with --no-tts)

# --- Optional overrides ---
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high - lower is faster for voice, higher reasons more carefully.
ANTHROPIC_EFFORT=medium
WHISPER_MODEL=whisper-1
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku
ELEVENLABS_MODEL=eleven_multilingual_v2

# Voice activity detection: seconds of silence that end your turn, and 0-3 aggressiveness.
VAD_SILENCE_SECONDS=1.5
VAD_AGGRESSIVENESS=2

# --- Demo / infrastructure ---
# DEMO_MODE=true runs Celery tasks in-process and uses the JSON store (no Postgres/Redis needed).
DEMO_MODE=true
DEMO_TODAY=2026-11-07
USER_CITY=Manchester
DATABASE_URL=postgresql://nataware:nataware@localhost:5432/nataware
REDIS_URL=redis://localhost:6379/0
